<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cqu</groupId>
    <artifactId>drs-initial</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <name>DRS-Initial</name>
    <description>Disaster Response System prototype, COIT20258 Assessment 2</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.2</javafx.version>
        <junit.version>5.10.2</junit.version>
        <mysql.connector.version>8.4.0</mysql.connector.version>
        <mainClass>com.cqu.drs.MainApp</mainClass>
    </properties>

    <dependencies>

        <!-- JavaFX: controls for the UI widgets, FXML for the Scene Builder layouts -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Gson: serialises the protocol messages, and reads the Assessment 2
             JSON files during migration -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>

        <!-- MySQL Connector/J: the JDBC driver for the data tier.

             This is a run time dependency only. Every class in com.cqu.drs.db
             and com.cqu.drs.repository is written against the java.sql
             interfaces in the JDK and none of them imports com.mysql.cj, so
             the project compiles whether or not the driver has been
             downloaded. The driver registers itself through
             META-INF/services/java.sql.Driver, so no Class.forName call is
             needed.

             mysql-connector-j is the current artifact. The older
             mysql:mysql-connector-java coordinate is deprecated and must not
             be used. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.connector.version}</version>
        </dependency>

        <!-- JUnit 5: unit testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- Surefire 3.x is required for JUnit 5 tests to be discovered -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- Run the application with: mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${mainClass}</mainClass>
                </configuration>
            </plugin>

            <!-- Runs the plain Java entry points, which have no JavaFX stage
                 and so cannot be started by javafx:run. Declared with a fixed
                 version so the command behaves the same on every machine:

                   mvn compile exec:java \
                     -Dexec.mainClass=com.cqu.drs.db.SchemaTool -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.1</version>
            </plugin>

        </plugins>
    </build>

</project>
