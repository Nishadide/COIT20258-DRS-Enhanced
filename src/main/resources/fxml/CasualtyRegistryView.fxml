<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cqu.drs.controller.CasualtyRegistryController"
            prefHeight="700.0" prefWidth="980.0" stylesheets="@../css/drs.css">

    <top>
        <VBox spacing="4.0" styleClass="header-bar">
            <Label styleClass="header-title" text="Casualty registry" />
            <Label styleClass="header-subtitle"
                   text="Names, contact numbers and notes are encrypted before they are stored. Record a casualty even when nobody knows who they are: only the triage category is required." />
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <VBox spacing="12.0" styleClass="content-pane">

                <Label styleClass="section-title" text="Report" />
                <TextArea fx:id="reportArea" editable="false" minHeight="60.0"
                          prefHeight="60.0" wrapText="true" />

                <VBox spacing="10.0" styleClass="card">
                    <Label styleClass="section-title" text="Register a casualty" />

                    <GridPane hgap="10.0" vgap="8.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="130.0" prefWidth="130.0" />
                            <ColumnConstraints minWidth="260.0" prefWidth="300.0" />
                            <ColumnConstraints minWidth="110.0" prefWidth="110.0" />
                            <ColumnConstraints minWidth="200.0" prefWidth="240.0" />
                        </columnConstraints>

                        <Label styleClass="field-label" text="Triage *"
                               GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <ComboBox fx:id="triageCombo" maxWidth="Infinity"
                                  GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label styleClass="field-label" text="Age"
                               GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <TextField fx:id="ageField" promptText="optional"
                                   GridPane.columnIndex="3" GridPane.rowIndex="0" />

                        <Label styleClass="field-label" text="Name"
                               GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="nameField" promptText="leave empty if unidentified"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label styleClass="field-label" text="Contact"
                               GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <TextField fx:id="contactField" promptText="optional"
                                   GridPane.columnIndex="3" GridPane.rowIndex="1" />

                        <Label styleClass="field-label" text="Found at"
                               GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextField fx:id="locationField" promptText="where on the scene"
                                   GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label styleClass="field-label" text="Notes"
                               GridPane.columnIndex="2" GridPane.rowIndex="2" />
                        <TextField fx:id="notesField" promptText="injuries, treatment given"
                                   GridPane.columnIndex="3" GridPane.rowIndex="2" />
                    </GridPane>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Button fx:id="registerButton" onAction="#handleRegister"
                                styleClass="button-primary" text="Register casualty" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="backButton" onAction="#handleBack"
                                styleClass="button-secondary" text="Back to dashboard" />
                    </HBox>

                    <Label fx:id="messageLabel" styleClass="error-text" wrapText="true" />
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label styleClass="section-title" text="Casualties on this disaster" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="summaryLabel" styleClass="hint-text" wrapText="true" />
                    <Button fx:id="refreshButton" onAction="#handleRefresh"
                            styleClass="button-secondary" text="Refresh" />
                </HBox>

                <TableView fx:id="casualtyTable" minHeight="190.0" prefHeight="220.0">
                    <columns>
                        <TableColumn fx:id="casualtyIdColumn" prefWidth="120.0" text="Record" />
                        <TableColumn fx:id="casualtyNameColumn" prefWidth="200.0" text="Name" />
                        <TableColumn fx:id="casualtyTriageColumn" prefWidth="140.0" text="Triage" />
                        <TableColumn fx:id="casualtyStatusColumn" prefWidth="160.0" text="Status" />
                        <TableColumn fx:id="casualtyLocationColumn" prefWidth="180.0" text="Found at" />
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <ComboBox fx:id="retriageCombo" promptText="New triage" />
                    <Button fx:id="retriageButton" onAction="#handleRetriage"
                            styleClass="button-secondary" text="Retriage selected" />
                    <TextField fx:id="hospitalField" prefWidth="200.0"
                               promptText="Hospital" />
                    <Button fx:id="referButton" onAction="#handleRefer"
                            styleClass="button-secondary" text="Refer selected" />
                    <Button fx:id="treatedButton" onAction="#handleTreatedOnSite"
                            styleClass="button-secondary" text="Treated on site" />
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
