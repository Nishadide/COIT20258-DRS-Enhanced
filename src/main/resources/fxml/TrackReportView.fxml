<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cqu.drs.controller.TrackReportController"
            prefHeight="680.0" prefWidth="980.0" stylesheets="@../css/drs.css">

    <top>
        <VBox spacing="4.0" styleClass="header-bar">
            <Label styleClass="header-title" text="Check a report" />
            <Label styleClass="header-subtitle"
                   text="Enter the reference number you were given when you lodged the report." />
        </VBox>
    </top>

    <center>
        <VBox spacing="14.0" styleClass="content-pane">

            <VBox spacing="10.0" styleClass="card">
                <Label styleClass="field-label" text="Reference number" />
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <TextField fx:id="referenceField" prefWidth="220.0" promptText="DR-0001" />
                    <Button fx:id="searchButton" defaultButton="true" onAction="#handleSearch"
                            styleClass="button-primary" text="Look up" />
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>
                <Label fx:id="messageLabel" styleClass="error-text" wrapText="true" />
            </VBox>

            <Label styleClass="section-title" text="Report" />
            <TextArea fx:id="resultArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                      promptText="The report will be shown here." />

            <HBox spacing="10.0">
                <Button fx:id="backButton" onAction="#handleBack"
                        styleClass="button-secondary" text="Back" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
