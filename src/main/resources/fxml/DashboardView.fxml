<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cqu.drs.controller.DashboardController"
            prefHeight="680.0" prefWidth="980.0" stylesheets="@../css/drs.css">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header-bar">
            <VBox spacing="2.0">
                <Label styleClass="header-title" text="Coordinator dashboard" />
                <Label fx:id="userLabel" styleClass="header-subtitle" text="Signed in" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="accountsButton" onAction="#handleAccounts"
                    styleClass="button-secondary" text="Accounts" />
            <Button fx:id="logoutButton" onAction="#handleLogout"
                    styleClass="button-secondary" text="Sign out" />
        </HBox>
    </top>

    <left>
        <VBox prefWidth="215.0" spacing="10.0" styleClass="side-panel">
            <Label styleClass="section-title" text="Filters" />

            <Label styleClass="field-label" text="Type" />
            <ComboBox fx:id="typeFilter" maxWidth="Infinity" promptText="All types" />

            <Label styleClass="field-label" text="Priority" />
            <ComboBox fx:id="priorityFilter" maxWidth="Infinity" promptText="All" />

            <Label styleClass="field-label" text="Status" />
            <ComboBox fx:id="statusFilter" maxWidth="Infinity" promptText="All" />

            <Button fx:id="clearFilterButton" maxWidth="Infinity" onAction="#handleClearFilters"
                    styleClass="button-secondary" text="Clear filters" />

            <Region VBox.vgrow="ALWAYS" />
            <Label fx:id="countLabel" styleClass="hint-text" wrapText="true" />
        </VBox>
    </left>

    <center>
        <VBox spacing="12.0" styleClass="content-pane">

            <Label styleClass="section-title" text="Active disasters, most urgent first" />

            <TableView fx:id="reportTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="referenceColumn" prefWidth="90.0" text="Ref" />
                    <TableColumn fx:id="typeColumn" prefWidth="110.0" text="Type" />
                    <TableColumn fx:id="locationColumn" prefWidth="215.0" text="Location" />
                    <TableColumn fx:id="severityColumn" prefWidth="130.0" text="Severity" />
                    <TableColumn fx:id="priorityColumn" prefWidth="80.0" text="Priority" />
                    <TableColumn fx:id="statusColumn" prefWidth="110.0" text="Status" />
                </columns>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Button fx:id="assessButton" onAction="#handleAssess"
                        styleClass="button-primary" text="Assess" />
                <Button fx:id="coordinateButton" onAction="#handleCoordinate"
                        styleClass="button-primary" text="Coordinate" />
                <Button fx:id="alertButton" onAction="#handleIssueAlert"
                        styleClass="button-danger" text="Issue alert" />
                <Button fx:id="nearbyButton" onAction="#handleNearby"
                        styleClass="button-secondary" text="Nearby reports" />
                <Button fx:id="resolveButton" onAction="#handleResolve"
                        styleClass="button-secondary" text="Resolve" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="refreshButton" onAction="#handleRefresh"
                        styleClass="button-secondary" text="Refresh" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
